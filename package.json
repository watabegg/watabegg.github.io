{
  "name": "watabegg",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "IDENTITY_SOURCE=local LOCAL_DOCUMENTS=0 astro dev",
    "build": "pnpm build:public",
    "build:public": "IDENTITY_SOURCE=local LOCAL_DOCUMENTS=0 astro build && pnpm --dir slide install --frozen-lockfile && pnpm --dir slide build",
    "build:example": "IDENTITY_SOURCE=example LOCAL_DOCUMENTS=0 astro build && pnpm --dir slide install --frozen-lockfile && pnpm --dir slide build",
    "preview": "astro preview",
    "astro": "astro",
    "ts": "tsc --noEmit",
    "check": "pnpm ts && pnpm exec astro check && pnpm exec biome check .",
    "check:fix": "biome check --fix",
    "identity:check": "IDENTITY_SOURCE=local pnpm ts && IDENTITY_SOURCE=local pnpm exec astro check",
    "identity:new": "node scripts/create-experience.mjs",
    "documents:dev": "IDENTITY_SOURCE=local LOCAL_DOCUMENTS=1 astro dev --host 127.0.0.1",
    "documents:build": "IDENTITY_SOURCE=local LOCAL_DOCUMENTS=1 astro build --outDir .documents-dist",
    "documents:pdf": "IDENTITY_SOURCE=local node scripts/generate-documents.mjs",
    "verify:public": "node scripts/verify-public-dist.mjs",
    "deploy": "IDENTITY_SOURCE=local PUBLIC_DIST_DIR=dist node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.5",
    "daisyui": "^5.5.5",
    "gsap": "^3.13.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.48.2",
    "tailwindcss": "^4.2.1"
  }
}
