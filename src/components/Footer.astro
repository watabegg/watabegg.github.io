---
import { socialLinks } from '@/data/constant'

const socialIconSpritePath = '/icons/social.svg'
---

<div class="relative z-10 container mx-auto py-16 px-12 flex flex-col-reverse md:flex-row justify-between items-center text-center">
  <p class="text-sm mb-4 md:mb-0 opacity-80">&copy; {new Date().getFullYear()} watabegg. All rights reserved.</p>
  <div id="social-links-footer" class="flex items-center space-x-4">
    {socialLinks.map((link) => {
      return (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="opacity-75 transition-opacity duration-300 hover:opacity-100"
          aria-label={link.name}
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <use href={`${socialIconSpritePath}#${link.iconId}`} />
          </svg>
        </a>
      )
    })}
    <a
      href="/rss.xml"
      class="opacity-75 transition-opacity duration-300 hover:opacity-100"
      aria-label="RSSを購読"
    >
      <svg
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <use href={`${socialIconSpritePath}#rss`} />
      </svg>
    </a>
  </div>
</div>
