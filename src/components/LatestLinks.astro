---
import { getCollection } from 'astro:content';
import QiitaIcon from '../assets/qiita.png';
import ZennIcon from '../assets/zenn.png';
import RealIcon from '../assets/real_icon.webp';
import { fetchQiitaItems } from '../lib/qiita';
import { fetchZennItems } from '../lib/zenn';

interface Props { mode: 'product' | 'blog' }
const { mode } = Astro.props as Props;

const [products, blogs] = await Promise.all([
  getCollection('products'),
  getCollection('blog')
]);

const now = new Date();

const latestProduct = products
  .filter((product) => !product.data.draft && product.data.publishDate.valueOf() <= now.valueOf())
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate)[0] ?? null;

const latestBlog = [...blogs]
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate)[0] ?? null;

const [latestQiitaResult, latestZennResult] = await Promise.all([
  fetchQiitaItems(1),
  fetchZennItems(1),
]);

const qiitaItem = latestQiitaResult.items[0] ?? null;
const zennItem = latestZennResult.items[0] ?? null;

const latestExternal = (() => {
  if (!qiitaItem && !zennItem) return null;
  if (qiitaItem && !zennItem) return { kind: 'qiita' as const, item: qiitaItem };
  if (!qiitaItem && zennItem) return { kind: 'zenn' as const, item: zennItem };
  return qiitaItem!.createdAt.valueOf() >= zennItem!.createdAt.valueOf()
    ? { kind: 'qiita' as const, item: qiitaItem! }
    : { kind: 'zenn' as const, item: zennItem! };
})();
---
{mode === 'product' && latestProduct && (
  <span
    class="inline-flex items-center gap-[0.1rem] ml-2 text-xs leading-[1.1] opacity-80 flex-wrap"
    aria-label="Latest product"
  >
    <a href={`/product/${latestProduct.slug}`} data-astro-prefetch class="inline-flex items-center gap-1.5 text-white border-b border-dashed border-white/30 pb-px no-underline transition hover:opacity-100 hover:-translate-y-px">
      {latestProduct.data.imageUrl ? (
        <img src={latestProduct.data.imageUrl} alt="product" class="w-[14px] h-[14px] rounded-[3px] object-cover bg-transparent shrink-0" loading="lazy" />
      ) : (
        <span class="inline-block w-[14px] h-[14px] rounded-[3px] bg-transparent" />
      )}
      <span class="truncate max-w-[11rem]">{latestProduct.data.title}</span>
    </a>
  </span>
)}

{mode === 'blog' && (
  <span
    class="inline-flex items-center gap-[0.1rem] ml-2 text-xs leading-[1.1] opacity-80 flex-wrap"
    aria-label="Latest blog items"
  >
    {latestBlog && (
      <a href={`/blog/${latestBlog.slug}`} data-astro-prefetch class="inline-flex items-center gap-1.5 text-white border-b border-dashed border-white/30 pb-px no-underline transition hover:opacity-100 hover:-translate-y-px">
        <img src={RealIcon.src} alt="blog" class="w-[14px] h-[14px] rounded-[3px] object-cover bg-transparent shrink-0" width={18} height={18} loading="lazy" />
        <span class="truncate max-w-[11rem]">{latestBlog.data.title}</span>
      </a>
    )}
    {latestBlog && latestExternal ? <span class="opacity-40 mx-1 text-white">/</span> : null}
    {latestExternal && (
      <a href={latestExternal.item.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-white border-b border-dashed border-white/30 pb-px no-underline transition hover:opacity-100 hover:-translate-y-px">
        <img
          src={(latestExternal.kind === 'qiita' ? QiitaIcon : ZennIcon).src}
          alt={latestExternal.kind === 'qiita' ? 'Qiita' : 'Zenn'}
          class="w-[14px] h-[14px] rounded-[3px] object-cover bg-transparent shrink-0"
          width={18}
          height={18}
          loading="lazy"
        />
        <span class="truncate max-w-[11rem]">{latestExternal.item.title}</span>
      </a>
    )}
  </span>
)}
