---
import { getCollection } from 'astro:content';
import QiitaIcon from '../assets/qiita.png';
import RealIcon from '../assets/real_icon.webp';
import { fetchQiitaItems } from '../lib/qiita';

interface Props { mode: 'product' | 'blog' }
const { mode } = Astro.props as Props;

// Fetch latest product & blog from local content collections
const [products, blogs] = await Promise.all([
  getCollection('products'),
  getCollection('blog')
]);

const latestProduct = [...products]
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate)[0] ?? null;

const latestBlog = [...blogs]
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate)[0] ?? null;

const latestQiita = (await fetchQiitaItems(1))[0] ?? null;
---

<style>
  .latest-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0.5rem;
    font-size: 0.875rem; /* ~14px on base */
    line-height: 1.1;
    opacity: 0.85;
    flex-wrap: wrap;
  }

  .latest-inline a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255,255,255,0.95);
    text-decoration: none;
    border-bottom: 1px dashed rgba(255,255,255,0.3);
    padding-bottom: 1px;
  }

  .latest-inline a:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .latest-thumb {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    object-fit: cover;
    background: none;
  }

  .latest-sep {
    opacity: 0.35;
    margin: 0 0.25rem;
  }
</style>

{mode === 'product' && latestProduct && (
  <span class="latest-inline" aria-label="Latest product">
    <a href={`/product/${latestProduct.slug}`} data-astro-prefetch>
      {latestProduct.data.imageUrl ? (
        <img src={latestProduct.data.imageUrl} alt="product" class="latest-thumb" loading="lazy" />
      ) : (
        <span class="latest-thumb" />
      )}
      <span class="truncate max-w-[12rem]">{latestProduct.data.title}</span>
    </a>
  </span>
)}

{mode === 'blog' && (
  <span class="latest-inline" aria-label="Latest blog items">
    {latestBlog && (
      <a href={`/blog/${latestBlog.slug}`} data-astro-prefetch>
        <img src={RealIcon.src} alt="blog" class="latest-thumb" width={18} height={18} loading="lazy" />
        <span class="truncate max-w-[12rem]">{latestBlog.data.title}</span>
      </a>
    )}
    {latestBlog && latestQiita ? <span class="latest-sep">/</span> : null}
    {latestQiita && (
      <a href={latestQiita.url} target="_blank" rel="noopener noreferrer">
        <img src={QiitaIcon.src} alt="Qiita" class="latest-thumb" width={18} height={18} loading="lazy" />
        <span class="truncate max-w-[12rem]">{latestQiita.title}</span>
      </a>
    )}
  </span>
)}
