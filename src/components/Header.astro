---
import { links } from '../data/constant';

const currentPath = Astro.url.pathname;
---
<nav class="relative z-20 container mx-auto flex items-center p-4 text-lg md:text-xl">
  <ul class="flex items-center space-x-4 md:space-x-6">
    {links.map(link => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <li>
          <a
            href={link.href}
            class:list={[
              "inline-flex items-center gap-2 pb-1 hover:opacity-80 transition-opacity duration-200",
              { "border-b-2 border-primary-content font-semibold": isActive },
              { "opacity-75": !isActive }
            ]}
          >
            <span class="md:hidden inline-flex items-center justify-center">
              <link.icon class="w-5 h-5" />
              <span class="sr-only">{link.name}</span>
            </span>
            <span class="hidden md:inline">{link.name}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
