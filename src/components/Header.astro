---
import { links } from '../data/constant'

const currentPath = Astro.url.pathname
const maxVisibleMobileLinks = 4
const visibleLinks = links.slice(0, maxVisibleMobileLinks)
const overflowLinks = links.slice(maxVisibleMobileLinks)
---
<nav class="relative z-10 container mx-auto flex items-center p-4 text-lg md:text-xl">
  <ul class="hidden md:flex items-center space-x-4 md:space-x-6">
    {links.map(link => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <li>
          <a
            href={link.href}
            class:list={[
              "inline-flex items-center gap-2 pb-1 hover:opacity-80 transition-opacity duration-200",
              { "border-b-2 border-primary-content font-semibold": isActive },
              { "opacity-75": !isActive }
            ]}
          >
            <span>{link.name}</span>
          </a>
        </li>
      );
    })}
  </ul>

  <div class="flex items-center gap-2 md:hidden">
    <ul class="flex items-center space-x-4">
      {visibleLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                "inline-flex items-center gap-2 pb-1 hover:opacity-80 transition-opacity duration-200",
                { "border-b-2 border-primary-content font-semibold": isActive },
                { "opacity-75": !isActive }
              ]}
            >
              <span>{link.name}</span>
            </a>
          </li>
        );
      })}
    </ul>

    {overflowLinks.length > 0 && (
      <div class="dropdown dropdown-end">
        <button tabindex={0} class="btn btn-ghost btn-sm px-2 leading-none">…</button>
        <ul tabindex={0} class="dropdown-content menu p-2 shadow bg-base-100 rounded-box z-50 w-44">
          {overflowLinks.map(link => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "text-base-content hover:opacity-80 transition-opacity duration-200",
                    { "font-semibold": isActive },
                    { "opacity-75": !isActive }
                  ]}
                >
                  {link.name}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </div>
</nav>
