---
import type { ProductContentSections } from '../lib/product';
import {
  calculateDurationMonths,
  formatPeriodLabel,
  parsePeriodRange,
} from '../lib/product';

interface Props {
  content: ProductContentSections;
}

const { content } = Astro.props as Props;
const periodRange = parsePeriodRange(content.period);
const periodLabel = formatPeriodLabel(periodRange);
const durationMonths = calculateDurationMonths(periodRange);
---

<section class="space-y-10">
  <div class="space-y-3" id="overview">
    <h2 class="text-2xl font-semibold" id="overview-heading">概要</h2>
    <p class="whitespace-pre-line leading-relaxed">{content.overview}</p>
  </div>

  <div class="space-y-3" id="period">
    <h2 class="text-2xl font-semibold" id="period-heading">期間</h2>
    <p>{periodLabel}（{durationMonths}カ月）</p>
  </div>

  <div class="space-y-3" id="tech-stack">
    <h2 class="text-2xl font-semibold" id="tech-stack-heading">使用技術</h2>
    <ul class="space-y-2">
      {content.techStack.map((item) => (
        <li>
          <span class="font-medium">{item.name}</span>
          {item.note && <span class="text-base-content/70"> — {item.note}</span>}
        </li>
      ))}
    </ul>
  </div>

  <div class="space-y-3" id="responsibilities">
    <h2 class="text-2xl font-semibold" id="responsibilities-heading">業務領域</h2>
    <ul class="list-disc list-inside space-y-2">
      {content.responsibilities.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>

  {content.improvements.length > 0 && (
    <div class="space-y-3" id="improvements">
      <h2 class="text-2xl font-semibold" id="improvements-heading">工夫点</h2>
      <ol class="list-decimal list-inside space-y-2">
        {content.improvements.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </div>
  )}

  {content.deliverables.length > 0 && (
    <div class="space-y-3" id="deliverables">
      <h2 class="text-2xl font-semibold" id="deliverables-heading">成果物</h2>
      <ul class="list-disc list-inside space-y-2">
        {content.deliverables.map((item) => (
          <li>
            <a href={item.url} class="text-primary hover:text-primary/80 hover:underline" target="_blank" rel="noopener noreferrer">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  {content.extra && (
    <div class="space-y-3" id="extra">
      <h2 class="text-2xl font-semibold" id="extra-heading">余談</h2>
      <p class="whitespace-pre-line leading-relaxed">{content.extra}</p>
    </div>
  )}
</section>
