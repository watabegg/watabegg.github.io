---
import type { ChronologyItem } from '../view-models/documents'

type Props = {
	items: ChronologyItem[]
	emptyMessage?: string
}

const { items, emptyMessage = '記載事項なし' } = Astro.props
---

{items.length > 0 ? (
	<table class="chronology-table">
		<thead>
			<tr>
				<th scope="col">年月</th>
				<th scope="col">経歴</th>
			</tr>
		</thead>
		<tbody>
			{items.map((item) => (
				<tr>
					<td>{item.period}</td>
					<td>
						<span class="chronology-description">{item.description}</span>
						{item.note && <span class="chronology-note">{item.note}</span>}
					</td>
				</tr>
			))}
		</tbody>
	</table>
) : (
	<p class="empty-note">{emptyMessage}</p>
)}
