---
import '@/styles/global.css'
import { Image } from 'astro:assets'
import { ClientRouter, fade } from 'astro:transitions'
import FigureImage from '@/assets/figure_1_1.webp'
import IconImage from '@/assets/real_icon.webp'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'

interface Props {
	title?: string
	description?: string
	isFullScreen?: boolean
	ogImageUrl?: string
	ogType?: 'website' | 'article'
}

const {
	title = 'watabegg',
	description = 'watabeggの個人サイト',
	isFullScreen = false,
	ogImageUrl,
	ogType = 'website',
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)

const defaultOgImageUrl = new URL(
	'/images/ogp_default.png',
	Astro.site,
).toString()
const finalOgImageUrl = ogImageUrl
	? new URL(ogImageUrl, Astro.site).toString()
	: defaultOgImageUrl
---
<!doctype html>
<html lang="ja" prefix="og: http://ogp.me/ns#">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />

		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl.toString()} />

		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl.toString()} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={finalOgImageUrl} />
		<meta property="og:site_name" content="watabegg" />
		<meta property="og:locale" content="ja_JP" />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl.toString()} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={finalOgImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "url": Astro.site?.toString(),
      "name": "watabegg",
      "description": description,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${Astro.site?.toString()}search?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    <script>
      import '@/layouts/Layout.client'
    </script>
		<ClientRouter />
	</head>
	<body class={`flex flex-col min-h-screen bg-base-100 text-base-content ${isFullScreen ? 'is-home' : ''}`}>
		<div id="bg-layer" aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden z-5">
			<div id="header-bg" class="bg-panel bg-primary"></div>
			<div id="footer-bg" class="bg-panel bg-primary"></div>
		</div>

		{ !isFullScreen && (
		<header class="relative text-primary-content top-0 overflow-visible z-20">
			<Header />
		</header>
		)}
		<main class="relative grow flex items-center justify-center overflow-hidden">
			{ isFullScreen && (
				<div class="absolute w-full md:w-3/5 lg:w-2/5 h-2/5 md:h-full bottom-[20%] md:bottom-0 md:right-[20%] flex flex-row md:flex-col justify-around z-0">
					<Image
						src={IconImage}
						alt="watabeggのアイコン"
						class="w-3/5 md:w-full mt-auto md:m-auto opacity-80"
						loading="lazy"
						priority
						transition:name='icon'
						transition:animate={fade({ duration: 1 })}
					/>
					<Image
						src={FigureImage}
						alt="watabeggのフィギュア"
						class="w-3/5 md:w-full mt-auto md:m-auto opacity-80"
						loading="lazy"
						priority
						transition:name='figure'
						transition:animate={fade({ duration: 1 })}
					/>
				</div>
			)}
			<slot />
		</main>
		{ !isFullScreen && (
			<footer class="relative text-primary-content overflow-hidden">
				<Footer />
			</footer>
		) }
	</body>
</html>
