---
import { getPublicIdentity } from '@/identity/load'
import Layout from '@/layouts/Layout.astro'
import { getPublishedProducts } from '@/lib/products'

const products = await getPublishedProducts()
const { profile } = getPublicIdentity()
---
<Layout title={`Products | ${profile.site.title}`}>
  <div class="page-section max-w-5xl text-center md:text-left w-full">
    <h1 class="text-4xl md:text-5xl font-bold opacity-90 self-center md:self-start">
      作ったやつ
    </h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
      {products.map(product => (
        <article class="content-card overflow-hidden flex flex-col text-left cursor-pointer">
          {product.data.imageUrl ? (
            <img src={product.data.imageUrl} alt={`${product.data.title}のOGP画像`} class="aspect-2/1 object-cover bg-base-200" />
          ) : (
            <div class="aspect-2/1 bg-base-300 flex items-center justify-center text-base-content opacity-50">No Image</div>
          )}
          <div class="p-5 flex flex-col grow">
            <h2 class="text-xl font-semibold mb-2 text-base-content line-clamp-1">
              <a href={`/product/${product.id}`} class="hover:text-primary">
                {product.data.title}
              </a>
            </h2>
            <p class="text-base-content opacity-80 mb-4 grow line-clamp-2">{product.data.description}</p>
            <p class="text-sm text-base-content opacity-60 mb-4">
              公開日: {product.data.publishDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            {product.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {product.data.tags.map(tag => (
                  <span class="tag-badge">{tag}</span>
                ))}
              </div>
            )}
            <a href={`/product/${product.id}`} class="read-more-link">
              詳細を見る &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
