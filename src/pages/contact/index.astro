---
import pgpKeyText from '@/assets/pgp/public-key.asc?raw'
import pgpKey from '@/assets/pgp/public-key.asc?url'
import { getPublicIdentity } from '@/identity/load'
import Layout from '@/layouts/Layout.astro'

const { profile } = getPublicIdentity()
const twitter = profile.socialLinks.find((link) => link.iconId === 'twitter')
const pgpKeyTxt = pgpKeyText
	.replace(/-----BEGIN PGP PUBLIC KEY BLOCK-----/g, '')
	.replace(/-----END PGP PUBLIC KEY BLOCK-----/g, '')
	.replace(/\s+/g, ' ')
	.trim()
---
<Layout title={`Contact | ${profile.site.title}`}>
  <div class="container mx-auto px-6 py-16 flex flex-col items-center text-center md:text-left max-w-3xl space-y-6 md:space-y-8 text-base-content">
    <h1 class="text-4xl md:text-5xl font-bold opacity-90 self-center md:self-start">
      お問い合わせ
    </h1>
    <section class="opacity-85 transition duration-300 ease-in-out hover:opacity-100 w-full bg-base-100 p-6 rounded-lg shadow-md text-left">
      <p class="mb-6 text-base-content opacity-90">
        お問い合わせは、以下のいずれかの方法でご連絡ください。
      </p>
      <dl class="space-y-2 text-base md:text-lg text-left">
        <div class="flex flex-col md:flex-row">
          <dt class="w-full md:w-24 font-medium text-gray-500 shrink-0">Gmail:</dt>
          <dd class="flex-1"><a href={`mailto:${profile.person.email}`} class="text-primary hover:text-primary/80 hover:underline">{profile.person.email}</a></dd>
        </div>
        {twitter && (
          <div class="flex flex-col md:flex-row">
            <dt class="w-full md:w-24 font-medium text-gray-500 shrink-0">Twitter:</dt>
            <dd class="flex-1"><a href={twitter.href} target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary/80 hover:underline">@{profile.person.handle}</a></dd>
          </div>
        )}
      </dl>
    </section>
    
    <section class="opacity-85 transition duration-300 ease-in-out hover:opacity-100 w-full bg-base-100 p-6 rounded-lg shadow-md text-left">
      <h2 class="text-2xl font-semibold mb-4 opacity-90">PGP 公開鍵</h2>
      <p class="mb-4 text-base-content opacity-90">
      </p>
      <div class="bg-base-200 p-4 rounded-md overflow-x-auto">
        <pre class="whitespace-pre-wrap break-all text-sm"><code>{pgpKeyTxt}</code></pre>
      </div>
      <div class="mt-4">
        <a href={pgpKey} download class="btn btn-primary btn-sm">
          公開鍵をダウンロード
        </a>
      </div>
    </section>
  </div>
</Layout>
