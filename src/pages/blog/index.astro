---
import { getCollection } from 'astro:content'
import QiitaIcon from '@/assets/qiita.png'
import ZennIcon from '@/assets/zenn.png'
import Layout from '@/layouts/Layout.astro'
import { fetchQiitaItems } from '@/lib/qiita'
import { fetchZennItems } from '@/lib/zenn'
import type { BlendItem } from '@/types/blog'

const MAX_EXTERNAL_ITEMS = 100
const socialIconSpritePath = '/icons/social.svg'

const [localPostsRaw, qiitaResult, zennResult] = await Promise.all([
	getCollection('blog'),
	fetchQiitaItems(MAX_EXTERNAL_ITEMS),
	fetchZennItems(MAX_EXTERNAL_ITEMS),
])

const localPosts = localPostsRaw.sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
)

const blended: BlendItem[] = [
	...localPosts.map((p) => ({
		kind: 'local' as const,
		slug: p.id,
		title: p.data.title,
		description: p.data.description,
		author: p.data.author,
		publishDate: p.data.publishDate,
		tags: p.data.tags,
	})),
	...qiitaResult.items.map((q) => ({
		kind: 'qiita' as const,
		title: q.title,
		url: q.url,
		createdAt: q.createdAt,
	})),
	...zennResult.items.map((z) => ({
		kind: 'zenn' as const,
		title: z.title,
		url: z.url,
		createdAt: z.createdAt,
	})),
].sort((a, b) => {
	const ad =
		a.kind === 'local' ? a.publishDate.valueOf() : a.createdAt.valueOf()
	const bd =
		b.kind === 'local' ? b.publishDate.valueOf() : b.createdAt.valueOf()
	return bd - ad
})

const externalMeta = {
	qiita: {
		label: 'Qiita',
		icon: QiitaIcon,
		badgeClass: 'bg-emerald-500/15 text-emerald-600',
	},
	zenn: {
		label: 'Zenn',
		icon: ZennIcon,
		badgeClass: 'bg-sky-500/15 text-sky-600',
	},
} as const
---
<Layout title="Blog | watabeggの個人サイト">
  <div class="page-section max-w-3xl text-center md:text-left w-full">
    <div class="flex flex-row justify-between items-center w-full">
      <h1 class="text-4xl md:text-5xl font-bold opacity-90 self-center md:self-start">
        ブログ
      </h1>
      <a
        href="/rss.xml"
        class="self-center md:self-auto opacity-75 transition-opacity duration-300 hover:opacity-100 mr-4"
        aria-label="RSSを購読"
      >
        <svg
          class="w-7 h-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <use href={`${socialIconSpritePath}#rss`} />
        </svg>
      </a>
    </div>
    <div class="space-y-10 w-full">
      {blended.map(item => {
        if (item.kind === 'local') {
          return (
            <article class="content-card p-6 text-left">
              <h2 class="text-2xl font-semibold mb-2 text-base-content">
                <a href={`/blog/${item.slug}`} class="hover:text-primary">
                  {item.title}
                </a>
              </h2>
              <p class="text-sm text-base-content opacity-60 mb-3">
                作成者: {item.author} | 公開日: {item.publishDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <p class="text-base-content opacity-80 mb-4">{item.description}</p>
              {item.tags && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {item.tags.map(tag => (
                    <span class="tag-badge">{tag}</span>
                  ))}
                </div>
              )}
              <a href={`/blog/${item.slug}`} class="read-more-link">
                続きを読む &rarr;
              </a>
            </article>
          )
        }
        const meta = externalMeta[item.kind]
        return (
          <article class="content-card p-6 text-left">
            <div class="flex items-center gap-2 mb-2">
              <img src={meta.icon.src} alt={meta.label} class="w-5 h-5" width={20} height={20} loading="lazy" />
              <span class:list={['text-xs px-2 py-0.5 rounded-full tracking-wide', meta.badgeClass]}>{meta.label}</span>
            </div>
            <h2 class="text-2xl font-semibold mb-2 text-base-content">
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary">
                {item.title}
              </a>
            </h2>
            <p class="text-sm text-base-content opacity-60 mb-3">
              公開日: {item.createdAt.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })} | 出典: {meta.label}
            </p>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="read-more-link">
              記事を読む ↗
            </a>
          </article>
        )
      })}
      {blended.length === 0 && (
        <p class="text-sm text-base-content/70 text-center">まだ記事がありません。</p>
      )}
    </div>
  </div>
</Layout>
