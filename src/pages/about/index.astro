---
import { Image } from 'astro:assets'
import IconImage2 from '@/assets/figure_1_1.webp'
import IconImage3 from '@/assets/figure_dots.webp'
import IconImage from '@/assets/real_icon.webp'
import IconImage4 from '@/assets/sumatera.webp'
import DefinitionList from '@/components/DefinitionList.astro'
import { profile } from '@/data/profile'
import Layout from '@/layouts/Layout.astro'

const iconObjects = [IconImage, IconImage2, IconImage3, IconImage4]

const birthDate = new Date(profile.head.birthDate)
const personalInfo = [
	{
		term: '本名',
		description: `${profile.head.name} (${profile.head.furigana})`,
	},
	{ term: '住所', description: profile.head.address },
	{ term: 'メールアドレス', description: profile.head.email },
	{ term: '性別', description: profile.head.gender },
	{
		term: '生年月日(ISO8601)',
		description: `${birthDate.toISOString()} (±12h)`,
	},
	{
		term: '生年月日(UNIX)',
		description: `${Math.floor(birthDate.getTime() / 1000)} (±43200)`,
	},
]

const careerHistory = profile.education.map((item) => ({
	term: item.period,
	description: item.description,
}))

const programSkills = [
	{ term: '言語', description: profile.skills.languages.join(', ') },
	{
		term: 'フレームワーク',
		description: [...profile.skills.frameworks].join(', '),
	},
	{ term: 'ライブラリ', description: profile.skills.libraries.join(', ') },
	{ term: 'OS', description: profile.skills.os.join(', ') },
	{ term: 'DB', description: profile.skills.db.join(', ') },
	{ term: 'PaaS', description: profile.skills.paas.join(', ') },
	{ term: 'その他関連ツール', description: profile.skills.tools.join(', ') },
]
---

<Layout title="About | watabeggの個人サイト">
  <div id="about-content" class="page-section max-w-3xl text-center md:text-left">
    <div id="about-icon" class="icon-stage mb-12 mx-auto w-40 h-40 md:w-48 md:h-48 relative">
      {iconObjects.map((iconObj, index) => {
        return (
          <Image
            src={iconObj}
            alt={`watabeggのアイコン ${index + 1}`}
            class:list={[
              'rotating-icon-item w-full h-full rounded-full object-cover shadow-lg absolute inset-0',
              index !== 0 ? 'opacity-0' : 'opacity-90',
            ]}
            loading="lazy"
            priority={index === 0}
            transition:name={index === 0 ? 'icon' : (index === 1 ? 'figure' : '')}
          />
        );
      })}
    </div>
    <span class="text-lg md:text-xl w-full font-semibold text-center text-base-content mb-4 self-center md:self-start">
      @watabegg
    </span>

    <h1 class="text-4xl md:text-5xl w-full font-bold opacity-90 text-center md:self-start">
      About
    </h1>

    <section class="hover-section">
      <h2 class="text-2xl md:text-3xl font-semibold mb-3">個人情報</h2>
      <DefinitionList items={personalInfo} />
    </section>

    <section class="hover-section">
      <h2 class="text-2xl md:text-3xl font-semibold mb-3">経歴</h2>
      <DefinitionList items={careerHistory} />
    </section>

    <section class="hover-section">
      <h2 class="text-2xl md:text-3xl font-semibold mb-3">プログラミングスキル</h2>
      <DefinitionList items={programSkills} />
    </section>

    <section class="hover-section">
      <h2 class="text-2xl md:text-3xl font-semibold mb-3">趣味</h2>
      <div class="flex flex-col gap-y-8 justify-center items-center">
        <iframe
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          height="450"
          class="apple-music-embed"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
          src="https://embed.music.apple.com/jp/playlist/%E8%B6%A3%E5%91%B3-2025-11/pl.u-mJy834RCzmbbrEp"
        ></iframe>
        <div class="aspect-video w-full max-w-175 rounded-lg overflow-hidden">
          <iframe
            class="w-full h-full"
            src="https://www.youtube.com/embed/n96cgEBWhl8?si=XECNRS89Vz2ehK28"
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  </div>

  <script>
    import '@/scripts/about.client'
  </script>
</Layout>

<style>
  .icon-stage {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .rotating-icon-item {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .apple-music-embed {
    width: 100%;
    max-width: 660px;
    overflow: hidden;
    border-radius: 10px;
  }
</style>
