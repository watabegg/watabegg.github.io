---
import Layout from '../layouts/Layout.astro';
import DefinitionList from '../components/DefinitionList.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';
import { calculateAge } from '../lib/time';
import { buildProductExperience } from '../lib/product';

const referenceDate = new Date();
const age = calculateAge(new Date(profile.head.birthDate), referenceDate);

const products = await getCollection('products');

const experiences = products
  .map((product) => buildProductExperience(product, referenceDate))
  .filter((experience) => experience.includeInSkillsheet)
  .sort((a, b) => a.sortKey - b.sortKey);

const headList = [
  { term: '氏名', description: `${profile.head.name} (${profile.head.furigana})` },
  { term: '性別', description: profile.head.gender },
  { term: '生年月日', description: `${profile.head.birthDate} (${age}歳)` },
  { term: '現住所', description: profile.head.address },
  { term: 'メールアドレス', description: profile.head.email },
];

const skillList = [
  { term: '言語', description: profile.skills.languages.join(', ') },
  { term: 'フレームワーク', description: [...profile.skills.frameworks].join(', ') },
  { term: 'ライブラリ', description: profile.skills.libraries.join(', ') },
  { term: 'OS', description: profile.skills.os.join(', ') },
  { term: 'DB', description: profile.skills.db.join(', ') },
  { term: 'PaaS', description: profile.skills.paas.join(', ') },
  { term: 'その他関連ツール', description: profile.skills.tools.join(', ') },
];
---

<Layout title="Skill Sheet | watabeggの個人サイト">
  <div class="skillsheet container mx-auto px-6 py-16 max-w-5xl text-base-content">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-2">Skill Sheet</h1>
      <p class="text-sm text-base-content/70">更新日: {referenceDate.toLocaleDateString('ja-JP')}</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/skillsheet.pdf" target="_blank" rel="noopener noreferrer">
          生成済みPDFをダウンロード
        </a>
        <a class="btn btn-outline" href="/skillsheet/pdf/" target="_blank" rel="noopener noreferrer">
          PDF用プレビューを開く
        </a>
      </div>
    </header>

    <section class="skillsheet-section">
      <h2 class="section-title">基本情報</h2>
      <DefinitionList items={headList} />

      <h3 class="sub-title">学歴・職歴</h3>
      <ul class="list-disc list-inside space-y-2">
        {profile.education.map((item) => (
          <li>{item.period} — {item.description}</li>
        ))}
      </ul>
    </section>

    <section class="skillsheet-section">
      <h2 class="section-title">スキル</h2>
      <DefinitionList items={skillList} termWidthClass="md:w-64" />
    </section>

    <section class="skillsheet-section">
      <h2 class="section-title">経験</h2>
      <div class="overflow-x-auto">
        <table class="skillsheet-table w-full">
          <thead>
            <tr>
              <th scope="col">期間</th>
              <th scope="col">内容</th>
              <th scope="col">業務領域</th>
              <th scope="col">技術</th>
              <th scope="col">成果物</th>
            </tr>
          </thead>
          <tbody>
            {experiences.map((experience) => (
              <tr>
                <td>
                  <div class="font-medium">{experience.periodLabel}</div>
                  <div class="text-sm text-base-content/70">{experience.durationMonths}カ月</div>
                </td>
                <td>
                  <div class="font-semibold mb-1">{experience.title}</div>
                  <p class="text-sm text-base-content/80 whitespace-pre-line">{experience.summary}</p>
                </td>
                <td>
                  <ul class="list-disc list-inside space-y-1 text-sm">
                    {experience.responsibilities.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </td>
                <td>
                  <ul class="list-disc list-inside space-y-1 text-sm">
                    {experience.techStack.map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                </td>
                <td>
                  <ul class="list-disc list-inside space-y-1 text-sm">
                    {experience.deliverables.map((deliverable) => (
                      <li>
                        <a href={deliverable.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary/80 hover:underline">
                          {deliverable.label}
                        </a>
                        <span class="print-url"> ({deliverable.url})</span>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<style>
  .skillsheet {
    font-family: 'Noto Sans JP', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .skillsheet-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .sub-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .skillsheet-table {
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .skillsheet-table th,
  .skillsheet-table td {
    border: 1px solid hsl(var(--bc) / 0.15);
    padding: 1rem;
    vertical-align: top;
  }

  .skillsheet-table th {
    background: hsl(var(--b2));
    text-align: left;
    font-weight: 600;
  }

  .print-url {
    display: none;
  }

  @media print {
    :global(body) {
      margin: 0;
    }

    .skillsheet {
      padding: 2.5cm 2cm;
      color: #000;
    }

    .skillsheet a {
      color: #000;
      text-decoration: underline;
    }

    .print-url {
      display: inline;
      font-size: 0.75em;
    }

    .skillsheet-section {
      page-break-inside: avoid;
    }

    header {
      page-break-after: avoid;
    }
  }
</style>
