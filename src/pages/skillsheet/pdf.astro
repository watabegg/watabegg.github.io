---
import { getCollection } from 'astro:content'
import { profile } from '../../data/profile'
import { buildProductExperience } from '../../lib/product'
import { calculateAge } from '../../lib/time'

const referenceDate = new Date()
const age = calculateAge(new Date(profile.head.birthDate), referenceDate)

const experiences = (await getCollection('products'))
	.map((entry) => buildProductExperience(entry, referenceDate))
	.filter((experience) => experience.includeInSkillsheet)
	.sort((a, b) => a.sortKey - b.sortKey)

const definitionItems = [
	['氏名', `${profile.head.name} (${profile.head.furigana})`],
	['性別', profile.head.gender],
	['生年月日', `${profile.head.birthDate} (${age}歳)`],
	['現住所', profile.head.address],
	['メールアドレス', profile.head.email],
]

const skillItems = [
	['言語', profile.skills.languages.join(', ')],
	['フレームワーク', profile.skills.frameworks.join(', ')],
	['ライブラリ', profile.skills.libraries.join(', ')],
	['OS', profile.skills.os.join(', ')],
	['DB', profile.skills.db.join(', ')],
	['PaaS', profile.skills.paas.join(', ')],
	['その他関連ツール', profile.skills.tools.join(', ')],
]
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="m-0 bg-white text-slate-800 font-['Noto_Sans_JP',_sans-serif] antialiased" style="font-feature-settings:'palt' 1;">
    <main class="flex flex-col gap-[18mm] px-[12mm] py-[16mm] text-[12px] leading-[1.55] print:px-[10mm] print:py-[12mm] print:gap-[14mm]">
      <header class="flex items-start justify-between">
        <div>
          <h1 class="text-[24px] font-semibold tracking-[0.04em] m-0">Skill Sheet</h1>
          <p class="mt-1 text-[11px] text-slate-500">更新日: {referenceDate.toLocaleDateString('ja-JP')}</p>
        </div>
      </header>

      <section class="space-y-3">
        <h2 class="text-[16px] font-semibold border-b border-slate-300 pb-1 mb-2">基本情報</h2>
        <dl class="grid grid-cols-[32mm_1fr] gap-y-[6px] gap-x-[10px]">
          {definitionItems.map((item) => {
            const [term, description] = item;
            return (
              <div class="contents">
                <dt class="font-semibold text-slate-700">{term}</dt>
                <dd class="m-0">{description}</dd>
              </div>
            );
          })}
        </dl>
        
        <h3 class="text-[14px] font-semibold mt-4 mb-1.5">学歴・職歴</h3>
        <ul class="list-disc pl-[14px] space-y-[2px] m-0">
          {profile.education.map((item) => (
            <li>{item.period} — {item.description}</li>
          ))}
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-[16px] font-semibold border-b border-slate-300 pb-1 mb-2">スキル</h2>
        <dl class="grid grid-cols-[32mm_1fr] gap-y-[6px] gap-x-[10px]">
          {skillItems.map((item) => {
            const [term, description] = item;
            return (
              <div class="contents">
                <dt class="font-semibold text-slate-700">{term}</dt>
                <dd class="m-0">{description}</dd>
              </div>
            );
          })}
        </dl>
      </section>

      <section class="space-y-3">
        <h2 class="text-[16px] font-semibold border-b border-slate-300 pb-1 mb-2">経験</h2>
        <table class="w-full border-collapse text-[11.5px]">
          <thead>
            <tr>
              <th class="border border-slate-300 bg-slate-100 font-semibold p-2 align-top text-left" scope="col">期間</th>
              <th class="border border-slate-300 bg-slate-100 font-semibold p-2 align-top text-left" scope="col">内容</th>
              <th class="border border-slate-300 bg-slate-100 font-semibold p-2 align-top text-left" scope="col">業務領域</th>
              <th class="border border-slate-300 bg-slate-100 font-semibold p-2 align-top text-left" scope="col">技術</th>
              <th class="border border-slate-300 bg-slate-100 font-semibold p-2 align-top text-left" scope="col">成果物</th>
            </tr>
          </thead>
          <tbody>
            {experiences.map((experience) => (
              <tr class="print:break-inside-avoid">
                <td class="border border-slate-300 p-2 align-top">
                  <div class="font-semibold">{experience.periodLabel}</div>
                  <div class="text-[10px] text-slate-500">{experience.durationMonths}カ月</div>
                </td>
                <td class="border border-slate-300 p-2 align-top">
                  <div class="font-semibold mb-[2px]">{experience.title}</div>
                  <p class="m-0 whitespace-pre-line">{experience.summary}</p>
                </td>
                <td class="border border-slate-300 p-2 align-top">
                  <ul class="list-disc pl-[14px] space-y-[2px] m-0">
                    {experience.responsibilities.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </td>
                <td class="border border-slate-300 p-2 align-top">
                  <ul class="list-disc pl-[14px] space-y-[2px] m-0">
                    {experience.techStack.map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                </td>
                <td class="border border-slate-300 p-2 align-top">
                  <ul class="list-disc pl-[14px] space-y-[2px] m-0">
                    {experience.deliverables.map((deliverable) => (
                      <li>
                        <span class="block font-semibold">{deliverable.label}</span>
                        <span class="block text-[10px] text-slate-600 break-all">{deliverable.url}</span>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
