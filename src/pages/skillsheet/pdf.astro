---
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';
import { calculateAge } from '../../lib/time';
import { buildProductExperience } from '../../lib/product';

const referenceDate = new Date();
const age = calculateAge(new Date(profile.head.birthDate), referenceDate);

const experiences = (await getCollection('products'))
  .map((entry) => buildProductExperience(entry, referenceDate))
  .filter((experience) => experience.includeInSkillsheet)
  .sort((a, b) => a.sortKey - b.sortKey);

const definitionItems = [
  ['氏名', `${profile.head.name} (${profile.head.furigana})`],
  ['性別', profile.head.gender],
  ['生年月日', `${profile.head.birthDate} (${age}歳)`],
  ['現住所', profile.head.address],
  ['メールアドレス', profile.head.email],
];

const skillItems = [
  ['言語', profile.skills.languages.join(', ')],
  ['フレームワーク', profile.skills.frameworks.join(', ')],
  ['ライブラリ', profile.skills.libraries.join(', ')],
  ['OS', profile.skills.os.join(', ')],
  ['DB', profile.skills.db.join(', ')],
  ['PaaS', profile.skills.paas.join(', ')],
  ['その他関連ツール', profile.skills.tools.join(', ')],
];
---

<head>
  <meta charset="utf-8" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
  />
</head>

<main class="pdf-container">
  <header class="pdf-header">
    <div>
      <h1>Skill Sheet</h1>
      <p class="updated">更新日: {referenceDate.toLocaleDateString('ja-JP')}</p>
    </div>
  </header>

  <section class="pdf-section">
    <h2>基本情報</h2>
    <dl class="definition-grid">
      {definitionItems.map((item) => {
        const [term, description] = item;
        return (
          <div class="definition-row">
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        );
      })}
    </dl>
    
    <h3>学歴・職歴</h3>
    <ul class="list">
      {profile.education.map((item) => (
        <li>{item.period} — {item.description}</li>
      ))}
    </ul>
  </section>

  <section class="pdf-section">
    <h2>スキル</h2>
    <dl class="definition-grid">
      {skillItems.map((item) => {
        const [term, description] = item;
        return (
          <div class="definition-row">
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        );
      })}
    </dl>
  </section>

  <section class="pdf-section">
    <h2>経験</h2>
    <table class="experience-table">
      <thead>
        <tr>
          <th scope="col">期間</th>
          <th scope="col">内容</th>
          <th scope="col">業務領域</th>
          <th scope="col">技術</th>
          <th scope="col">成果物</th>
        </tr>
      </thead>
      <tbody>
        {experiences.map((experience) => (
          <tr>
            <td>
              <div class="period">{experience.periodLabel}</div>
              <div class="duration">{experience.durationMonths}カ月</div>
            </td>
            <td>
              <div class="title">{experience.title}</div>
              <p class="summary">{experience.summary}</p>
            </td>
            <td>
              <ul class="list">
                {experience.responsibilities.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </td>
            <td>
              <ul class="list">
                {experience.techStack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </td>
            <td>
              <ul class="list">
                {experience.deliverables.map((deliverable) => (
                  <li>
                    <span class="link-label">{deliverable.label}</span>
                    <span class="link-url">{deliverable.url}</span>
                  </li>
                ))}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</main>

<style>
  :global(body) {
    margin: 0;
    font-family: 'Noto Sans JP', 'Noto Sans', 'Yu Gothic Medium', 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;
    color: #1f2933;
    background: #fff;
    font-feature-settings: 'palt' 1;
  }

  .pdf-container {
    padding: 16mm 12mm;
    display: flex;
    flex-direction: column;
    gap: 18mm;
    font-size: 12px;
    line-height: 1.55;
  }

  .pdf-header h1 {
    font-size: 24px;
    margin: 0;
    letter-spacing: 0.04em;
  }

  .updated {
    margin-top: 4px;
    font-size: 11px;
    color: #5f6c7b;
  }

  .pdf-section h2 {
    font-size: 16px;
    margin: 0 0 8px;
    border-bottom: 1px solid #cbd5e1;
    padding-bottom: 4px;
  }

  .pdf-section h3 {
    font-size: 14px;
    margin: 16px 0 6px;
  }

  .definition-grid {
    display: grid;
    grid-template-columns: 32mm 1fr;
    row-gap: 6px;
    column-gap: 10px;
  }

  .definition-row {
    display: contents;
  }

  dt {
    font-weight: 600;
    color: #3d4859;
  }

  dd {
    margin: 0;
  }

  .list {
    list-style: disc;
    padding-left: 14px;
    margin: 0;
  }

  .list li {
    margin-bottom: 2px;
  }

  .experience-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11.5px;
  }

  .experience-table th,
  .experience-table td {
    border: 1px solid #d5dbe3;
    padding: 6px 8px;
    vertical-align: top;
  }

  .experience-table th {
    background: #f3f4f6;
    font-weight: 600;
  }

  .period {
    font-weight: 600;
  }

  .duration {
    font-size: 10px;
    color: #5f6c7b;
  }

  .title {
    font-weight: 600;
    margin-bottom: 2px;
  }

  .summary {
    margin: 0;
    white-space: pre-line;
  }

  .link-label {
    display: block;
    font-weight: 600;
  }

  .link-url {
    display: block;
    font-size: 10px;
    color: #475569;
    word-break: break-all;
  }

  @media print {
    :global(body) {
      margin: 0;
    }

    .pdf-container {
      padding: 12mm 10mm;
      gap: 14mm;
    }
  }
</style>
