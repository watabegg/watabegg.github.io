---
import { getCollection } from 'astro:content'
import DefinitionList from '../../components/DefinitionList.astro'
import { profile } from '../../data/profile'
import Layout from '../../layouts/Layout.astro'
import { buildProductExperience } from '../../lib/product'
import { calculateAge } from '../../lib/time'

const referenceDate = new Date()
const age = calculateAge(new Date(profile.head.birthDate), referenceDate)

const products = await getCollection('products')

const experiences = products
	.map((product) => buildProductExperience(product, referenceDate))
	.filter((experience) => experience.includeInSkillsheet)
	.sort((a, b) => a.sortKey - b.sortKey)

const headList = [
	{
		term: '氏名',
		description: `${profile.head.name} (${profile.head.furigana})`,
	},
	{ term: '性別', description: profile.head.gender },
	{ term: '生年月日', description: `${profile.head.birthDate} (${age}歳)` },
	{ term: '現住所', description: profile.head.address },
	{ term: 'メールアドレス', description: profile.head.email },
]

const skillList = [
	{ term: '言語', description: profile.skills.languages.join(', ') },
	{
		term: 'フレームワーク',
		description: [...profile.skills.frameworks].join(', '),
	},
	{ term: 'ライブラリ', description: profile.skills.libraries.join(', ') },
	{ term: 'OS', description: profile.skills.os.join(', ') },
	{ term: 'DB', description: profile.skills.db.join(', ') },
	{ term: 'PaaS', description: profile.skills.paas.join(', ') },
	{ term: 'その他関連ツール', description: profile.skills.tools.join(', ') },
]
---

<Layout title="Skill Sheet | watabeggの個人サイト">
  <div class="container mx-auto px-6 py-16 max-w-5xl text-base-content print:px-[2cm] print:py-[2.5cm] print:text-black print:bg-white">
    <header class="mb-12 print:break-after-avoid">
      <h1 class="text-4xl font-bold mb-2">Skill Sheet</h1>
      <p class="text-sm text-base-content/70">更新日: {referenceDate.toLocaleDateString('ja-JP')}</p>
      <div class="mt-4 flex flex-wrap gap-3 print:hidden">
        <a class="btn btn-primary" href="/skillsheet.pdf" target="_blank" rel="noopener noreferrer">
          生成済みPDFをダウンロード
        </a>
        <a class="btn btn-outline" href="/skillsheet/pdf/" target="_blank" rel="noopener noreferrer">
          PDF用プレビューを開く
        </a>
      </div>
    </header>

    <section class="mb-12 space-y-4 print:break-inside-avoid">
      <h2 class="text-[1.75rem] font-semibold mb-6">基本情報</h2>
      <DefinitionList items={headList} />

      <h3 class="text-xl font-semibold mt-8 mb-4">学歴・職歴</h3>
      <ul class="list-disc list-inside space-y-2 text-base">
        {profile.education.map((item) => (
          <li>{item.period} — {item.description}</li>
        ))}
      </ul>
    </section>

    <section class="mb-12 space-y-4 print:break-inside-avoid">
      <h2 class="text-[1.75rem] font-semibold mb-6">スキル</h2>
      <DefinitionList items={skillList} termWidthClass="md:w-64" />
    </section>

    <section class="mb-12 space-y-6 print:break-inside-avoid">
      <h2 class="text-[1.75rem] font-semibold">経験</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-[0.95rem]">
          <thead>
            <tr>
              <th class="border border-base-content/15 bg-base-200 text-left font-semibold p-4 align-top" scope="col">期間</th>
              <th class="border border-base-content/15 bg-base-200 text-left font-semibold p-4 align-top" scope="col">内容</th>
              <th class="border border-base-content/15 bg-base-200 text-left font-semibold p-4 align-top" scope="col">業務領域</th>
              <th class="border border-base-content/15 bg-base-200 text-left font-semibold p-4 align-top" scope="col">技術</th>
              <th class="border border-base-content/15 bg-base-200 text-left font-semibold p-4 align-top" scope="col">成果物</th>
            </tr>
          </thead>
          <tbody>
            {experiences.map((experience) => (
              <tr class="print:break-inside-avoid">
                <td class="border border-base-content/15 p-4 align-top">
                  <div class="font-medium">{experience.periodLabel}</div>
                  <div class="text-sm text-base-content/70">{experience.durationMonths}カ月</div>
                </td>
                <td class="border border-base-content/15 p-4 align-top">
                  <div class="font-semibold mb-1">{experience.title}</div>
                  <p class="text-sm text-base-content/80 whitespace-pre-line">{experience.summary}</p>
                </td>
                <td class="border border-base-content/15 p-4 align-top">
                  <ul class="list-disc list-inside space-y-1 text-sm">
                    {experience.responsibilities.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </td>
                <td class="border border-base-content/15 p-4 align-top">
                  <ul class="list-disc list-inside space-y-1 text-sm">
                    {experience.techStack.map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                </td>
                <td class="border border-base-content/15 p-4 align-top">
                  <ul class="list-disc list-inside space-y-1 text-sm">
                    {experience.deliverables.map((deliverable) => (
                      <li>
                        <a href={deliverable.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary/80 hover:underline break-words">
                          {deliverable.label}
                        </a>
                        <span class="hidden print:inline text-[0.75em]"> ({deliverable.url})</span>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
